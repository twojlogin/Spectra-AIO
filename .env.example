# Spectra-AIO configuration
SPECTRA_HOST=127.0.0.1
SPECTRA_PORT=8000
# Proxy mode: tor | direct | custom
SPECTRA_PROXY_MODE=tor
# Tor / custom proxy URL
SPECTRA_TOR_PROXY=socks5h://127.0.0.1:9050
# SPECTRA_PROXY_URL=socks5h://127.0.0.1:9050
# SPECTRA_USE_TOR=0  # backward compat -> direct mode
# SPECTRA_TOR_HOST=127.0.0.1
# SPECTRA_TOR_PORT=9050
# SPECTRA_USER_AGENT=
# SPECTRA_REQUEST_TIMEOUT=15
# SPECTRA_DB_PATH=backend/profiles.db
# SPECTRA_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
